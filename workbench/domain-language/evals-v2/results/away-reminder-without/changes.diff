+
+def send_due_date_reminders(loans, users, today: date) -> int:
+    """Due Date Reminder: two days before the due date, for loans not yet returned."""
+    sent = 0
+    for loan in loans:
+        if loan["returned"] is None and loan["due"] - timedelta(days=2) == today:
+            patron = users[loan["user_id"]]
+            send_email(
+                patron["email"],
+                "Due soon: " + loan["title"],
+                f"This book is due back on {loan['due'].isoformat()}.",
+            )
+            sent += 1
+    return sent
